{
  "elements": [
    {
      "type": "SelectVariable",
      "name": "BatteryVariableID",
      "caption": "Batteriestand",
      "validVariableTypes": [1, 2]
    },
    {
      "type": "SelectVariable",
      "name": "ChargingActorVariableID",
      "caption": "Ladeaktor",
      "validVariableTypes": [0],
      "requiredAction": 1
    },
    {
      "type": "NumberSpinner",
      "name": "SwitchOnThreshold",
      "caption": "Einschaltschwelle",
      "minimum": 0,
      "maximum": 100,
      "suffix": " %"
    },
    {
      "type": "NumberSpinner",
      "name": "SwitchOffThreshold",
      "caption": "Ausschaltschwelle",
      "minimum": 0,
      "maximum": 100,
      "suffix": " %"
    },
    {
      "type": "CheckBox",
      "name": "ShowBatteryLevel",
      "caption": "Batteriestand als Statusvariable anzeigen"
    },
    {
      "type": "CheckBox",
      "name": "ShowChargingActorState",
      "caption": "Ladeaktorstatus als Statusvariable anzeigen"
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Standardwerte wiederherstellen",
      "onClick": [
        "if (!IPS_SetProperty($id, 'SwitchOnThreshold', 20)) { throw new RuntimeException('Die Einschaltschwelle konnte nicht zurückgesetzt werden.'); }",
        "if (!IPS_SetProperty($id, 'SwitchOffThreshold', 80)) { throw new RuntimeException('Die Ausschaltschwelle konnte nicht zurückgesetzt werden.'); }",
        "if (!IPS_ApplyChanges($id)) { throw new RuntimeException('Die Standardwerte konnten nicht übernommen werden.'); }"
      ]
    }
  ],
  "status": []
}
